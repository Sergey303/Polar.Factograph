{
  "schemaVersion": 1,
  "projectId": "syp-test",
  "name": "SypCassete compatibility project",
  "ontology": {
    "path": "./ontology.xml"
  },
  "index": {
    "path": "../project-data/syp-test/index",
    "rebuildMode": "whenSourcesChanged"
  },
  "cassettes": {
    "items": [
      "D:/projects/iis/cassettes/SypCassete"
    ],
    "write": "D:/projects/iis/cassettes/SypCassete"
  },
  "roles": {
    "viewer": {
      "projectRights": ["read", "search"],
      "cassetteRights": {
        "SypCassete": ["read"]
      }
    },
    "administrator": {
      "projectRights": ["read", "search", "export", "manageUsers", "manageCassettes", "rebuildIndex"],
      "cassetteRights": {
        "*": ["read", "manage"]
      }
    }
  },
  "members": [
    {
      "userId": "admin",
      "roles": ["administrator"],
      "cassetteOverrides": {}
    }
  ]
}
